# Copy to .env and fill in. Never commit .env.

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB=zombieloop

# Luminal
LUMINAL_API_KEY=
LUMINAL_BASE_URL=https://flash.luminal.cloud/v1
LUMINAL_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
LUMINAL_CONCURRENCY=4
LUMINAL_TIMEOUT_S=30
LUMINAL_HTTP_RETRIES=2
LUMINAL_MAX_TOKENS=2048
# Enable only after confirming JSON mode support on your endpoint.
LUMINAL_JSON_MODE=false

# On-device vision
OLLAMA_MODEL=qwen2.5vl:3b
